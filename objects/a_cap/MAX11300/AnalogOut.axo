<objdefs appVersion="1.1.0">
   <obj.normal id="AnalogOut" uuid="b06b93b3-70c5-47a4-b684-b142743d04ad">
      <sDescription>AnalogOut</sDescription>
      <author>AndyCap</author>
      <license>GPL</license>
      <helpPatch>MAX11300.axh</helpPatch>
      <inlets>
         <frac32.positive name="inp"/>
         <frac32.bipolar name="inb"/>
      </inlets>
      <outlets/>
      <displays/>
      <params/>
      <attribs>
         <spinner name="channel" MinValue="0" MaxValue="19" DefaultValue="0"/>
         <combo name="range">
            <MenuEntries>
               <string>0v to 10v</string>
               <string>-5V to 5V</string>
               <string>-10V to 0V</string>
            </MenuEntries>
            <CEntries>
               <string>MAX11300::vr0toP10</string>
               <string>MAX11300::vrN5toP5</string>
               <string>MAX11300::vrN10to0</string>
            </CEntries>
         </combo>
      </attribs>
      <includes>
         <include>./MAX11300.h</include>
      </includes>
      <depends>
         <depend>SPID3</depend>
      </depends>
      <code.init><![CDATA[MAX11300::SetAnalogOutputChannel(attr_channel, attr_range);
MAX11300::Initialise();]]></code.init>
      <code.dispose><![CDATA[MAX11300::Terminate();]]></code.dispose>
      <code.krate><![CDATA[// editing this
uint16_t uValP = inlet_inp >> 15;
uint16_t uValB = ((inlet_inb>>1)+(1<<26)) >> 15;
uint16_t uVal = uValP + uValB;

static uint16_t uDebug= 3000;
uDebug--;
if(uDebug == 0)
{
	uDebug = 3000;
	LogTextMessage("%u", uVal);
	
}
MAX11300::SetAnalogValue(attr_channel, uVal);]]></code.krate>
   </obj.normal>
</objdefs>
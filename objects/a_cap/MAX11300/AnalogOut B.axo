<objdefs appVersion="1.0.12">
   <obj.normal id="AnalogOut B" uuid="b06b93b3-70c5-47a4-b684-b142743d04ad">
      <sDescription>12 bit CV Output, to be used with the MAX11300.

Single output, bipolar input (-64...64).

Choose the channel you want to use.
Choose the range of the output.

Trim can be used to &quot;tune&quot; the output.

Offset and Scale can be used to act as an offset/attenuator of offset/amplifier for the output.</sDescription>
      <author>AndyCap</author>
      <license>GPL</license>
      <helpPatch>MAX11300.axh</helpPatch>
      <inlets>
         <frac32.bipolar name="in"/>
      </inlets>
      <outlets/>
      <displays/>
      <params>
         <frac32.s.map.ratio name="trim" description="Trim for tuning">
            <DefaultValue v="0.0"/>
         </frac32.s.map.ratio>
         <frac32.s.map.ratio name="scale" description="Scale output">
            <DefaultValue v="0.0"/>
         </frac32.s.map.ratio>
         <frac32.s.map.ratio name="offset">
            <DefaultValue v="0.0"/>
         </frac32.s.map.ratio>
      </params>
      <attribs>
         <spinner name="channel" description="MAX11300 Channel" MinValue="0" MaxValue="19" DefaultValue="0"/>
         <combo name="range" description="Voltage range">
            <MenuEntries>
               <string>0v to 10v</string>
               <string>-5V to 5V</string>
               <string>-10V to 0V</string>
            </MenuEntries>
            <CEntries>
               <string>MAX11300::vr0toP10</string>
               <string>MAX11300::vrN5toP5</string>
               <string>MAX11300::vrN10to0</string>
            </CEntries>
         </combo>
      </attribs>
      <includes>
         <include>./MAX11300.h</include>
      </includes>
      <depends>
         <depend>SPID3</depend>
      </depends>
      <code.init><![CDATA[MAX11300::SetAnalogOutputChannel(attr_channel, attr_range);
MAX11300::Initialise();]]></code.init>
      <code.dispose><![CDATA[MAX11300::Terminate();]]></code.dispose>
      <code.krate><![CDATA[#define MULTIPLY(x,y) ___SMMUL(x<<2, y<<3)
#define DEBUG_LOG 0

static constexpr int32_t ufOne = MAX11300::FloatToFixed(1.0f);
static constexpr int32_t ufPointOne = MAX11300::FloatToFixed(0.1f);
static constexpr int32_t ufPointFive = MAX11300::FloatToFixed(0.5f);

int32_t ufTrim = ufOne + MULTIPLY(ufPointOne, param_trim);
int32_t ufScale = ufOne + param_scale;
int32_t ufOffset = MULTIPLY(ufPointFive, param_offset);

// Convert to abs
int32_t ufAbs = MULTIPLY(ufPointFive, (inlet_in + ufOne));

// Trim
int32_t ufAfterTrim = MULTIPLY(ufAbs, ufTrim);

// Scale
int32_t ufAfterScale = MULTIPLY(ufAfterTrim, ufScale);

// offset
int32_t ufAfterOffset = ufAfterScale + ufOffset;

// clamp
if(ufAfterOffset > ufOne-1)
	ufAfterOffset = ufOne-1;
else if (ufAfterOffset < 0)
	ufAfterOffset = 0;

// convert to 12 bits
uint16_t uDacVal = ufAfterOffset >> (27-12);

// Write to DAC
MAX11300::SetAnalogValue(attr_channel, uDacVal);

// Debug log every second if wanted.
#if DEBUG_LOG
static int debug = 3000;
debug--;
if(!debug)
{
	debug = 3000;
	LogTextMessage("%u, fIn = %f, fAbs = %f, fTrim = %f, fScale = %f, fOffset = %f, fOne = %x", uDacVal, MAX11300::FixedToFloat(inlet_in), MAX11300::FixedToFloat(ufAbs), MAX11300::FixedToFloat(ufTrim), MAX11300::FixedToFloat(ufScale), MAX11300::FixedToFloat(ufOffset), ufOne);
}
#endif]]></code.krate>
   </obj.normal>
</objdefs>
<objdefs appVersion="1.1.0">
   <obj.normal id="N8AnalogOut B" uuid="035be832-b5f1-4289-8889-84059703a89c">
      <sDescription>N8AnalogOut B</sDescription>
      <author>AndyCap</author>
      <license>GPL</license>
      <helpPatch>N8MAX11300.axh</helpPatch>
      <inlets>
         <frac32.positive name="in"/>
      </inlets>
      <outlets/>
      <displays/>
      <params>
         <frac32.s.map.ratio name="trim">
            <DefaultValue v="0.0"/>
         </frac32.s.map.ratio>
         <frac32.s.map.ratio name="scale">
            <DefaultValue v="0.0"/>
         </frac32.s.map.ratio>
         <frac32.s.map.ratio name="offset">
            <DefaultValue v="0.0"/>
         </frac32.s.map.ratio>
      </params>
      <attribs>
         <spinner name="row" MinValue="1" MaxValue="6" DefaultValue="1"/>
         <spinner name="col" MinValue="1" MaxValue="3" DefaultValue="1"/>
         <combo name="range">
            <MenuEntries>
               <string>0v to 10v</string>
               <string>-5V to 5V</string>
               <string>-10V to 0V</string>
            </MenuEntries>
            <CEntries>
               <string>MAX11300::vr0toP10</string>
               <string>MAX11300::vrN5toP5</string>
               <string>MAX11300::vrN10to0</string>
            </CEntries>
         </combo>
      </attribs>
      <includes>
         <include>./MAX11300.h</include>
      </includes>
      <depends>
         <depend>SPID3</depend>
      </depends>
      <code.init><![CDATA[#define CHANNEL (channels[(attr_col-1) + ((attr_row-1)*3)])
MAX11300::SetAnalogOutputChannel(CHANNEL, attr_range);
MAX11300::Initialise();]]></code.init>
      <code.global><![CDATA[uint8_t channels[] = {0,1,10, 2,11,12, 3,4,13, 5,14,15, 6,7,16, 8,17,18};

float FixedToFloat(int32_t nVal)
{
  if (nVal < 0)
  {
    nVal -= 1;
    nVal = ~nVal;
    return -1 * (1.0f * nVal) / (1 << 27);
  }
  else
  {
    return (1.0f * nVal) / (1 << 27);
  }
}

constexpr int32_t FloatToFixed(float f)
{
  return (int32_t)(round(f * (1 << 27)));
}]]></code.global>
      <code.dispose><![CDATA[MAX11300::Terminate();]]></code.dispose>
      <code.krate><![CDATA[#define USE_FIXED 1
#if USE_FIXED

#define MULTIPLY(x,y) ___SMMUL(x<<2, y<<3)

static constexpr int32_t ufOne = FloatToFixed(1.0f);
static constexpr int32_t ufPointOne = FloatToFixed(0.1f);
static constexpr int32_t ufPointFive = FloatToFixed(0.5f);

int32_t ufTrim = ufOne + MULTIPLY(ufPointOne, param_trim);
int32_t ufScale = ufOne + param_scale;
int32_t ufOffset = MULTIPLY(ufPointFive, param_offset);

// Convert to abs
int32_t ufAbs = MULTIPLY(ufPointFive, (inlet_in + ufOne));

// Trim
int32_t ufAfterTrim = MULTIPLY(ufAbs, ufTrim);

// Scale
int32_t ufAfterScale = MULTIPLY(ufAfterTrim, ufScale);

// offset
int32_t ufAfterOffset = ufAfterScale + ufOffset;

// clamp
if(ufAfterOffset > ufOne)
	ufAfterOffset = ufOne;
else if (ufAfterOffset < 0)
	ufAfterOffset = 0;

// convert to 12 bits
uint16_t uDacVal = ufAfterOffset >> (27-12);

static int debug = 3000;
debug--;
if(!debug)
{
	debug = 3000;
	LogTextMessage("%u, fIn = %f, fAbs = %f, fTrim = %f, fScale = %f, fOffset = %f", uDacVal, FixedToFloat(inlet_in), FixedToFloat(ufAbs), FixedToFloat(ufTrim), FixedToFloat(ufScale), FixedToFloat(ufOffset));
}

#else
float fIn = FixedToFloat(inlet_in);
float fTrim = 1.0f + (0.1f * FixedToFloat(param_trim));
float fScale = 1.0f + FixedToFloat(param_scale);
float fOffset = 0.5f * FixedToFloat(param_offset);


// Convert to abs
float fAbs = 0.5f * (fIn + 1.0f);

// trim
float fAfterTrim = fAbs * fTrim;

// scale
float fAfterScale = fAfterTrim * fScale;

// offset
float fAfterOffset = fAfterScale + fOffset;

// Clamp to 0 to 1
if(fAfterOffset > 1.0f)
	fAfterOffset = 1.0f;
else if (fAfterOffset < 0.0f)
	fAfterOffset = 0.0f;
	
// convert to 12 bits
uint16_t uUnadjustedDacValue = 4095*fAbs;
uint16_t uDacVal = 4095*fAfterOffset;

static int debug = 3000;
debug--;
if(!debug)
{
	debug = 3000;
	LogTextMessage("%u from %u, fIn = %f, fAbs = %f, fTrim = %f, fScale = %f, fOffset = %f", uDacVal, uUnadjustedDacValue, fIn, fAbs, fTrim, fScale, fOffset);
}
#endif

MAX11300::SetAnalogValue(CHANNEL, uDacVal);]]></code.krate>
   </obj.normal>
</objdefs>
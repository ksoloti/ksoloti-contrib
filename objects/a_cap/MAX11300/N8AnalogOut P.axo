<objdefs appVersion="1.0.12">
   <obj.normal id="N8AnalogOut P" uuid="d18b25ea-943a-4ab5-8171-21c699a91496">
      <sDescription>12 bit CV Output, to be used with the N8 MAX11300 frankenboard.

Single output, unipolar input (0...64).

Choose the row and column of the output you want to use.
Choose the range of the output.

Trim can be used to &quot;tune&quot; the output.

Offset and Scale can be used to act as an offset/attenuator of offset/amplifier for the output.</sDescription>
      <author>AndyCap</author>
      <license>GPL</license>
      <helpPatch>N8MAX11300.axh</helpPatch>
      <inlets>
         <frac32.positive name="in"/>
      </inlets>
      <outlets/>
      <displays/>
      <params>
         <frac32.s.map.ratio name="trim" description="Trim for tuning">
            <DefaultValue v="0.0"/>
         </frac32.s.map.ratio>
         <frac32.s.map.ratio name="scale" description="Scale output">
            <DefaultValue v="0.0"/>
         </frac32.s.map.ratio>
         <frac32.s.map.ratio name="offset" description="Offset Output">
            <DefaultValue v="0.0"/>
         </frac32.s.map.ratio>
      </params>
      <attribs>
         <spinner name="row" description="N8 row" MinValue="1" MaxValue="6" DefaultValue="1"/>
         <spinner name="col" description="N8 Column" MinValue="1" MaxValue="3" DefaultValue="1"/>
         <combo name="range" description="Voltage Range">
            <MenuEntries>
               <string>0v to 10v</string>
               <string>-5V to 5V</string>
               <string>-10V to 0V</string>
            </MenuEntries>
            <CEntries>
               <string>MAX11300::vr0toP10</string>
               <string>MAX11300::vrN5toP5</string>
               <string>MAX11300::vrN10to0</string>
            </CEntries>
         </combo>
      </attribs>
      <includes>
         <include>./MAX11300.h</include>
      </includes>
      <depends>
         <depend>SPID3</depend>
      </depends>
      <code.init><![CDATA[MAX11300::SetAnalogOutputChannel(MAX11300::N8Channel(attr_col, attr_row), attr_range);
MAX11300::Initialise();]]></code.init>
      <code.dispose><![CDATA[MAX11300::Terminate();]]></code.dispose>
      <code.krate><![CDATA[#define MULTIPLY(x,y) ___SMMUL(x<<2, y<<3)
#define DEBUG_LOG 0

static constexpr int32_t ufOne = MAX11300::FloatToFixed(1.0f);
static constexpr int32_t ufPointOne = MAX11300::FloatToFixed(0.1f);
static constexpr int32_t ufPointFive = MAX11300::FloatToFixed(0.5f);

int32_t ufTrim = ufOne + MULTIPLY(ufPointOne, param_trim);
int32_t ufScale = ufOne + param_scale;
int32_t ufOffset = MULTIPLY(ufPointFive, param_offset);

// Trim
int32_t ufAfterTrim = MULTIPLY(inlet_in, ufTrim);

// Scale
int32_t ufAfterScale = MULTIPLY(ufAfterTrim, ufScale);

// offset
int32_t ufAfterOffset = ufAfterScale + ufOffset;

// clamp
if(ufAfterOffset > ufOne-1)
	ufAfterOffset = ufOne-1;
else if (ufAfterOffset < 0)
	ufAfterOffset = 0;

// convert to 12 bits
uint16_t uDacVal = ufAfterOffset >> (27-12);

// Write to DAC
MAX11300::SetAnalogValue(MAX11300::N8Channel(attr_col, attr_row), uDacVal);

// Debug log every second if wanted.
#if DEBUG_LOG
static int debug = 3000;
debug--;
if(!debug)
{
	debug = 3000;
	LogTextMessage("%u, fIn = %f, fTrim = %f, fScale = %f, fOffset = %f, fOne = %x", uDacVal, FixedToFloat(inlet_in), FixedToFloat(ufTrim), FixedToFloat(ufScale), FixedToFloat(ufOffset), ufOne);
}
#endif]]></code.krate>
   </obj.normal>
</objdefs>
<objdefs appVersion="1.1.0">
   <obj.normal id="N8AnalogIn" uuid="bf2a5033-6759-485a-9122-ee7ac8735301">
      <sDescription>N8 AnalogIn</sDescription>
      <author>AndyCap</author>
      <license>GPL</license>
      <helpPatch>MAX11300.axh</helpPatch>
      <inlets/>
      <outlets>
         <frac32.positive name="p" description="Unipolar Output"/>
         <frac32.bipolar name="b" description="Bipolar Output"/>
      </outlets>
      <displays/>
      <params/>
      <attribs>
         <spinner name="row" MinValue="1" MaxValue="6" DefaultValue="1"/>
         <spinner name="col" MinValue="1" MaxValue="3" DefaultValue="1"/>
         <combo name="range">
            <MenuEntries>
               <string>0v to 10v</string>
               <string>-5V to 5V</string>
               <string>-10V to 0V</string>
            </MenuEntries>
            <CEntries>
               <string>MAX11300::vr0toP10</string>
               <string>MAX11300::vrN5toP5</string>
               <string>MAX11300::vrN10to0</string>
            </CEntries>
         </combo>
         <combo name="oversample">
            <MenuEntries>
               <string>x1</string>
               <string>x2</string>
               <string>x4</string>
               <string>x8</string>
               <string>x16</string>
               <string>x32</string>
               <string>x64</string>
               <string>x128</string>
            </MenuEntries>
            <CEntries>
               <string>MAX11300::as1</string>
               <string>MAX11300::as2</string>
               <string>MAX11300::as4</string>
               <string>MAX11300::as8</string>
               <string>MAX11300::as16</string>
               <string>MAX11300::as32</string>
               <string>MAX11300::as64</string>
               <string>MAX11300::as128</string>
            </CEntries>
         </combo>
      </attribs>
      <includes>
         <include>./MAX11300.h</include>
      </includes>
      <depends>
         <depend>SPID3</depend>
      </depends>
      <code.init><![CDATA[MAX11300::SetAnalogInputChannel(MAX11300::N8Channel(attr_col, attr_row), attr_range, attr_oversample);
MAX11300::Initialise();]]></code.init>
      <code.dispose><![CDATA[MAX11300::Terminate();]]></code.dispose>
      <code.krate><![CDATA[uint16_t uAdcVal = MAX11300::GetAnalogValue(MAX11300::N8Channel(attr_col, attr_row));
outlet_p = uAdcVal << 15;
outlet_b = (outlet_p-(1<<26))<<1;]]></code.krate>
   </obj.normal>
</objdefs>
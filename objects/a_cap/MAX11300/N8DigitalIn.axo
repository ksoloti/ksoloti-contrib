<objdefs appVersion="1.1.0">
   <obj.normal id="N8DigitalIn" uuid="496f72c6-874b-4bfa-ac52-a5757a37933e">
      <sDescription>DigitalIn</sDescription>
      <author>AndyCap</author>
      <license>GPL</license>
      <helpPatch>MAX11300.axh</helpPatch>
      <inlets/>
      <outlets>
         <bool32 name="out1"/>
      </outlets>
      <displays/>
      <params/>
      <attribs>
         <spinner name="row" MinValue="1" MaxValue="6" DefaultValue="1"/>
         <spinner name="col" MinValue="1" MaxValue="3" DefaultValue="1"/>
      </attribs>
      <includes>
         <include>./MAX11300.h</include>
      </includes>
      <depends>
         <depend>SPID3</depend>
      </depends>
      <code.init><![CDATA[MAX11300::SetDigitalInputChannel(MAX11300::N8Channel(attr_col, attr_row));
MAX11300::Initialise();]]></code.init>
      <code.dispose><![CDATA[MAX11300::Terminate();]]></code.dispose>
      <code.krate><![CDATA[outlet_out1 = MAX11300::GetDigitalValue(MAX11300::N8Channel(attr_col, attr_row));]]></code.krate>
   </obj.normal>
</objdefs>